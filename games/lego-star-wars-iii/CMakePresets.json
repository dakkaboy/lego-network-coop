{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x86",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_ASM_COMPILER": "clang",
        "CMAKE_C_COMPILER_TARGET": "i686-pc-windows-msvc",
        "CMAKE_CXX_COMPILER_TARGET": "i686-pc-windows-msvc",
        "CMAKE_ASM_COMPILER_TARGET": "i686-pc-windows-msvc",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    }
  ]
}
